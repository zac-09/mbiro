{
  "name": "mbiro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "./scripts/build-nm-host.sh && pnpm --filter @mbiro/desktop tauri dev",
    "build": "./scripts/build-nm-host.sh && pnpm --filter @mbiro/desktop tauri build",
    "build:aria2": "./scripts/build-aria2.sh",
    "build:nm-host": "./scripts/build-nm-host.sh",
    "build:extension": "pnpm --filter @mbiro/extension build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
