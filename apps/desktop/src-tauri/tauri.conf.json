{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mbiro",
  "version": "0.0.0",
  "identifier": "dev.mbiro.app",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mbiro",
        "width": 1280,
        "height": 840,
        "minWidth": 520,
        "minHeight": 480,
        "backgroundColor": "#0C0D0E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/aria2c", "binaries/nm-host"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
