{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mbiro",
  "version": "0.0.0",
  "identifier": "dev.mbiro.app",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mbiro",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/aria2c", "binaries/nm-host"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
